<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cada acción muestra una respuesta visible al pulsarse." />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Variantes de botón" android:textStyle="bold" android:layout_marginTop="12dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.button.MaterialButton android:id="@+id/filled_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Relleno" /><com.google.android.material.button.MaterialButton android:id="@+id/outlined_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Contorno" /><com.google.android.material.button.MaterialButton android:id="@+id/text_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Texto" /></LinearLayout>
<ImageButton android:id="@+id/icon_button" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Eliminar" android:src="@android:drawable/ic_menu_delete" />
<com.google.android.material.button.MaterialButton android:id="@+id/icon_text_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:icon="@android:drawable/ic_menu_send" android:text="Enviar" />
<com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/extended_fab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Crear" android:layout_marginTop="12dp" />
<com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="Agregar" android:src="@android:drawable/ic_input_add" />
<com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/action_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Modo activo" />
<com.google.android.material.button.MaterialButton android:id="@+id/disabled_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Deshabilitado" android:enabled="false" />
<com.google.android.material.button.MaterialButton android:id="@+id/loading_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cargando" />
<ProgressBar android:id="@+id/loading_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
</LinearLayout></ScrollView>
