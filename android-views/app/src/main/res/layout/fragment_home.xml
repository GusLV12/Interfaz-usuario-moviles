<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Explora componentes móviles" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="Cada sección incluye una explicación y controles que puedes probar." />
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_text" style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="4dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:text="Entrada de texto\nCampos, validación, contraseñas, teclados y búsqueda." /></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_actions" style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="4dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:text="Botones y acciones\nAcciones con estados y respuestas visibles." /></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_selection" style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="4dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:text="Elementos de selección\nOpciones, interruptores, rangos y selectores." /></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_lists" style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="4dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:text="Listas y colecciones\nListas, cuadrículas, gestos y pestañas." /></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_feedback" style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="4dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:text="Información y retroalimentación\nMensajes, progreso, imágenes y diálogos." /></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_layout" style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="4dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:text="Contenedores y estructura\nFilas, columnas, superposiciones y navegación." /></com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
