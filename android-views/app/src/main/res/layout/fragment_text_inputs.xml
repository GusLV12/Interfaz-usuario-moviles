<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prueba distintos tipos de captura y observa validación y teclado." android:layout_marginBottom="12dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Campo simple\nCaptura un dato breve con una etiqueta clara." android:textStyle="bold" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:id="@+id/input_simple" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nombre" /></com.google.android.material.textfield.TextInputLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Campo con validación\nMuestra un error cuando el usuario no cumple la longitud requerida." android:textStyle="bold" android:layout_marginTop="12dp" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/layout_validation" android:layout_width="match_parent" android:layout_height="wrap_content" app:errorEnabled="true"><com.google.android.material.textfield.TextInputEditText android:id="@+id/input_validation" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Usuario (mínimo 3 caracteres)" /></com.google.android.material.textfield.TextInputLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Contraseña\nEl icono final permite mostrar u ocultar el valor." android:textStyle="bold" android:layout_marginTop="12dp" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/input_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Contraseña" android:inputType="textPassword" /></com.google.android.material.textfield.TextInputLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teclados especializados\nCada campo solicita el teclado adecuado para el tipo de dato." android:textStyle="bold" android:layout_marginTop="8dp" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Número" android:inputType="number" /></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Correo electrónico" android:inputType="textEmailAddress" /></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Teléfono" android:inputType="phone" /></com.google.android.material.textfield.TextInputLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Campo multilínea\nSirve para comentarios y descripciones más extensas." android:textStyle="bold" android:layout_marginTop="8dp" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Comentarios multilínea" android:minLines="3" android:gravity="top" android:inputType="textMultiLine" /></com.google.android.material.textfield.TextInputLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sugerencias y búsqueda\nOfrecen opciones frecuentes y filtran los componentes mostrados." android:textStyle="bold" android:layout_marginTop="12dp" />
    <AutoCompleteTextView android:id="@+id/input_suggestions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Sugerencias: ciudad" />
    <EditText android:id="@+id/input_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Buscar componente" android:inputType="text" />
    <TextView android:id="@+id/search_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Botón · Interruptor · Tarjeta · Deslizador" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Agregar a la lista\nUn texto válido se comparte con la sección Colecciones." android:textStyle="bold" android:layout_marginTop="12dp" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:id="@+id/input_pending" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nuevo elemento" /></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/button_add_item" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Agregar a la colección" />
</LinearLayout></ScrollView>
